# Google Maps API Key
# Get one at: https://console.cloud.google.com/
# Enable: Maps JavaScript API + Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# TfL (Transport for London) API Key — FREE
# Register at: https://api-portal.tfl.gov.uk/
# Sign up → subscribe to "500 Requests per min" product → copy your Primary Key
# Without this key the app still works but uses hardcoded commute times
VITE_TFL_KEY=your_tfl_key_here

# Unsplash API Key — FREE (50 requests/hour on demo tier)
# Register at: https://unsplash.com/developers
# Click "New Application" → fill in details → copy your "Access Key"
# Without this key cards show a colour gradient fallback instead of photos
VITE_UNSPLASH_KEY=your_unsplash_access_key_here

# RapidAPI Key — for real Zoopla property listings (optional)
# Register at: https://rapidapi.com/
# Subscribe to the "Zoopla" API (by apihouse) — free tier available
# Without this key the Zoopla tab shows realistic mock data
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
